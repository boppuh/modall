# Non-secret Cloudflare Access identity coordinates.
MODALL_OIDC_ISSUER=https://replace.cloudflareaccess.com
MODALL_OIDC_AUDIENCE=replace-with-access-application-aud
MODALL_OIDC_JWKS_URL=https://replace.cloudflareaccess.com/cdn-cgi/access/certs

# Absolute host paths. Create these outside the repository with owner-only permissions.
MODALL_DATABASE_URL_FILE_HOST=/opt/modall/secrets/database-url
MODALL_SECRET_MOUNT_ROOT_HOST=/opt/modall/secrets/provider
CLOUDFLARE_TUNNEL_TOKEN_FILE_HOST=/opt/modall/secrets/cloudflare-tunnel-token
MODALL_ALERTMANAGER_CONFIG_FILE_HOST=/opt/modall/secrets/alertmanager.yml
MODALL_GRAFANA_ADMIN_PASSWORD_FILE_HOST=/opt/modall/secrets/grafana-admin-password

MODALL_CONFIRMATION_HMAC_KEY_VERSIONS=["v1"]
MODALL_IDEMPOTENCY_HMAC_KEY_VERSIONS=["v1"]
MODALL_LOG_LEVEL=INFO

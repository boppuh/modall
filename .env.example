MODALL_ENVIRONMENT=local
MODALL_LOG_LEVEL=INFO
MODALL_DATABASE_URL=postgresql://modall:modall@localhost:5432/modall
MODALL_WORKER_POLL_INTERVAL_SECONDS=1
MODALL_WORKER_LEASE_DURATION_SECONDS=30
MODALL_WORKER_MAINTENANCE_INTERVAL_SECONDS=60
MODALL_WORKER_METRICS_PORT=9101
MODALL_API_MAX_CONCURRENCY=64
MODALL_API_QUEUE_TIMEOUT_SECONDS=0.25
MODALL_API_RATE_LIMIT_PER_MINUTE=600
MODALL_TRUSTED_PROXY_ADDRESSES=[]
MODALL_MAX_ARGUMENT_BYTES=65536
MODALL_MAX_RESULT_BYTES=262144
MODALL_CONFIRMATION_TTL_SECONDS=120
MODALL_MAX_RUN_SECONDS=300
MODALL_ARGUMENT_RETENTION_DAYS=14
MODALL_RESULT_RETENTION_DAYS=14
MODALL_RUN_RETENTION_DAYS=90
MODALL_MAX_ACTIVE_RUNS_PER_WORKSPACE=100
MODALL_RECONCILIATION_BATCH_SIZE=100
MODALL_SCHEMA_VALIDATION_TIMEOUT_SECONDS=2
MODALL_SCHEMA_VALIDATION_MEMORY_BYTES=268435456
MODALL_CONFIRMATION_HMAC_KEY_VERSIONS=["v1"]
MODALL_IDEMPOTENCY_HMAC_KEY_VERSIONS=["v1"]
MODALL_AUTH_MODE=local
MODALL_AUTH_TOKEN_SOURCE=authorization
MODALL_LOCAL_SUBJECT=local-developer
MODALL_SECRET_PROVIDER=fixture
MODALL_FIXTURE_SECRET_ROOT=.modall/fixture-secrets
